    "A file or folder with the same name already exists in %@. Replacing it will overwrite its current contents." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Datei oder ein Ordner gleichen Namens existiert bereits in %@. Beim Ersetzen wird der gegenwärtige Inhalt überschrieben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A file or folder with the same name already exists in %@. Replacing it will overwrite its current contents."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Existe un fichero o carpeta con el mismo nombre en %@. Si lo reemplzadas se perderá el contenido actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un fichier ou dossier portant le même nom existe déjà dans %@. Le remplacer aura pour effet d'écraser son contenu actuel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un file o cartella con lo stesso nome esiste già in %@. La sostituzione implicherà la sovrascrittura dei contenuti attuali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同じ名前のファイルまたはフォルダが %@ にすでに存在します。これを置き換えると現在の内容が上書きされます。"
          }
        }
      }
    },
