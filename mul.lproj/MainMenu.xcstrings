    "1581.title" : {
      "comment" : "Class = \"NSTextFieldCell\"; title = \"If you want to make a donation for LaTeXiT, you can access my Paypal account from my web site.\\n\\n\\n\\nYou have absolutely no obligation, LaTeXiT is a freeware and you can enjoy it that way\"; ObjectID = \"1581\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie für LaTeXiT spenden wollen, können Sie das PayPal-Konto auf meiner Webseite benutzen\n\n\n\nSie haben keinerlei Verpflichtungen, LaTeXiT ist  Freeware und von allen frei benutzbar"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you want to make a donation for LaTeXiT, you can access my Paypal account from my web site.\n\n\n\nYou have absolutely no obligation, LaTeXiT is a freeware and you can enjoy it that way"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "si quieres hacer una donación para LaTeXit, puedes acceder a mi cuenta en Paypal desde mi sitio web.\n\n\n\nPero no existe ninguna obligación para ello, LaTeXiT es gratuito y lo puedes disfrutar así"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si vous voulez faire un don pour LaTeXiT, vous pouvez accéder à mon compte Paypal depuis mon site web.\n\n\n\nVous n'avez absolument aucune obligation, LaTeXiT est un graticiel et vous pouvez en profiter comme tel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se vuoi fare una donazione per LaTeXiT, puoi accedere al mio account Paypal dal mio sito web.\n\n\n\nNon hai alcun obbligo, LaTeXiT è un software gratuito e puoi usarlo comunque."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LaTeXiT のために寄付をして頂けるなら、ウェブサイトから私の Paypal アカウントにアクセスしてください。\n\n\n\nLaTeXiT はフリーウェアソフトですのでもちろん寄付は義務ではありません。"
          }
        }
      }
    },
