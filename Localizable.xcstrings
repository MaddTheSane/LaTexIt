    "Are you sure you want to clear the whole history ?\nThis operation is irreversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wollen Sie tatsächlich den gesamten Verlauf löschen?\nDies kann nicht mehr rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to clear the whole history?\nThis operation is irreversible."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea borrar el historial al completo?\nEsta operación no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voulez-vous vraiment effacer entièrement l'historique ?\nCette operation est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler cancellare l'intera cronologia?\nQuesta operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全ての履歴を消去してもよろしいですか？\nこの操作は取り消せません。"
          }
        }
      }
    },
    "Are you sure you want to reset the preamble ?\nThis operation is irreversible." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind Sie sicher, dass die Preambel zurückgesetzt werden soll?\nDies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure you want to reset the preamble?\nThis operation cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Está seguro de que desea restablecer el preámbulo?\nEsta operación no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr de vouloir réinitialiser le préambule ?\nCette opération est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro di voler resettare il preambolo ?\nQuesta operazione è irreversibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プリアンブルを本当にリセットしますか？\nこの操作は取り消せません"
          }
        }
      }
    },
