    "Their old preamble will be overwritten. If it was a special preamble that had been tuned to generate them, it will be lost." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die alte Präambel wird überschrieben. Wenn diese eine speziell erstellte Präambel ist, wird sie verloren gehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Their old preamble will be overwritten. If it was a special preamble that had been tuned to generate them, it will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su anterior preámbulo se reemplazará. Si es un preámbulo especial contruido para generarlas se perderá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leur ancien préambule sera écrasé. S'il s'agissait d'un préambule spécial utilisé pour leur génération, il sera perdu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il loro vecchio preambolo sarà sovrascritto. Se era un preambolo straordinario usato per generarli, andrà perso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "古いプリアンブルは上書きされます。これまでの変換に必要な特別なプリアンブルだとすると、それが失われます。"
          }
        }
      }
    },
