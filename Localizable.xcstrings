    "%d equation could not be converted because of syntax errors in it. You should also check if it is compatible with the default preamble in use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gleichung %d konnte aufgrund eines Syntaxfehlers in ihr nicht bearbeitet werden. Sie sollten auch überprüfen, ob sie mit der verwendeten Standard-Präambel kompatibel ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d equation could not be converted because of syntax errors in it. You should also check if it is compatible with the default preamble in use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La ecuación %d no ha podido convertirse ya que presenta errores de syntaxis. Debes comprobar también si es compatible con el preámbulo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d equation n'a pas pu être convertie à cause d'erreurs de syntaxe. Vous devriez aussi vérifier que le préambule actuel est compatible avec elle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d l'equazione non può essere convertita a causa di errori di sintassi in essa. Controllare anche se è compatibile con il preambolo in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 数式がシンタックスエラーのため変換できませんでした。プリアンブルとの整合も確認してください。"
          }
        }
      }
    },
    "%d equations could not be converted because of syntax errors in them. You should also check if they are compatible with the default preamble in use." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d Gleichungen konnten aufgrund eines Syntaxfehlers in ihnen nicht bearbeitet werden. Sie sollten auch überprüfen, ob sie mit der verwendeten Standard-Präambel kompatibel sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d equations could not be converted because of syntax errors in them. You should also check if they are compatible with the default preamble in use."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las ecuaciones %d no han podido convertirse ya que presentan errores de syntaxis. Debes comprobar también si son compatible con el preámbulo actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d equations n'ont pas pu être converties à cause d'erreurs de syntaxe. Vous devriez aussi vérifier que le préambule actuel est compatible avec ces équations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d le equazioni non possono essere convertite per errori di sintassi in esse. Controllare inoltre se sono compatibili con il preambolo in uso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%d 複数の数式がシンタックスエラーのため変換できませんでした。プリアンブルとの整合についても確認してください。"
          }
        }
      }
    },
